---
import SectionHeading from './SectionHeading.astro'

// The case for hiring, above the fold. Every claim here is drawn from the
// vendored resume (src/data/resume.json); keep them in step when it changes.
const proofs = [
    {
        claim: 'Staging rebuilds from hours to minutes',
        source: '@Lindsay',
    },
    {
        claim: 'DevSecOps for product and infra teams',
        source: '@Datadog',
    },
    {
        claim: 'Published research and high-impact defensive cyber operations',
        source: '@MITRE',
    },
]
---

<section aria-labelledby="whoami" class="flex flex-col gap-5">
    <SectionHeading id="whoami">About Me</SectionHeading>
    <p class="text-[17px] leading-snug sm:text-[18px]">
        Production-grade CI/CD and paved-road security for SWEs and agents.
    </p>
    <p class="text-[17px] leading-snug sm:text-[18px]">
        Seasoned operator with hyperscale, gov/mil/intel and Fortune 50 experience.
    </p>
    <ul class="flex flex-col gap-3">
        {
            proofs.map((proof) => (
                <li class="flex gap-3">
                    <svg
                        class="mt-1.5 flex-shrink-0 -rotate-6"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--color-redpen)"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <p class="text-[15px] leading-relaxed">
                        {proof.claim}{' '}
                        <span class="whitespace-nowrap font-mono text-s" style="color: var(--color-secondary);">
                            {proof.source}
                        </span>
                    </p>
                </li>
            ))
        }
    </ul>
</section>
