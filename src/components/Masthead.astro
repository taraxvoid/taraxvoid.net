---
import ThemeToggle from './ThemeToggle.astro'

interface Props {
    active?: 'activities' | 'resume'
}

const { active } = Astro.props

const navLink = (href: string, label: string, key: string) => ({
    href,
    label,
    current: active === key,
})

const links = [
    navLink('/activities', 'Activities', 'activities'),
    navLink('/resume', 'Resume', 'resume'),
]
---

<header class="flex flex-col items-center gap-4 md:flex-row md:justify-between px-5 py-4">
    <a href="/" class="masthead-lockup flex flex-nowrap items-center justify-center gap-2 sm:gap-3" aria-label="Tara X Void, home">
        <span aria-hidden="true" class="font-redaction-100 text-[34px] leading-none">[</span>
        <div class="font-redaction-50 text-[22px] tracking-wide whitespace-nowrap">Tara \X/ Void</div>
        <div
            class="w-fit -rotate-6 border-2 px-2.5 py-0.5 font-redaction-50 text-sm"
            style="border-color: var(--color-redpen); color: var(--color-redpen); border-radius: 3px 7px 4px 8px / 6px 3px 8px 4px; box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-redpen) 15%, transparent);"
        >
            Active
        </div>
        <span aria-hidden="true" class="font-redaction-100 text-[34px] leading-none">]</span>
    </a>
    <div class="flex flex-wrap items-center justify-center gap-2.5">
    <nav class="flex flex-wrap justify-center gap-2.5 text-sm">
        {
            links.map((link) => (
                <a
                    href={link.current ? '/' : link.href}
                    aria-current={link.current ? 'page' : undefined}
                    class="masthead-nav-link px-4 py-2 font-redaction-35 text-sm uppercase tracking-[0.08em]"
                >
                    {link.label}
                </a>
            ))
        }
    </nav>
    <ThemeToggle />
    </div>
</header>

<style>
    a.masthead-lockup {
        color: var(--color-ink);
        text-decoration: none;
    }
    a.masthead-lockup:hover,
    a.masthead-lockup:focus-visible {
        color: var(--color-ink);
        opacity: 0.75;
    }
    a.masthead-nav-link {
        display: inline-block;
        border: 1px solid var(--color-ink);
        color: var(--color-ink);
        text-decoration: none;
        transition:
            background-color 0.15s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }
    a.masthead-nav-link:hover,
    a.masthead-nav-link:focus-visible {
        background: var(--color-ink);
        color: var(--color-paper);
    }
    a.masthead-nav-link[aria-current='page'] {
        background: var(--color-verified);
        border-color: var(--color-verified);
        color: var(--color-on-verified);
    }
</style>
