---
import ThemeToggle from './ThemeToggle.astro'

interface Props {
    active?: 'resume'
}

const { active } = Astro.props
const onResume = active === 'resume'
---

{
    /* Side rules frame the header as one block. Resume and the theme toggle
    sit on the name's row, Resume right-most; the GitHub handle sits under
    the name as part of the lockup. */
}
<header class="masthead">
    <a href="/" class="masthead-lockup" aria-label="Tara X Void, home">
        <span class="font-redaction-20 text-2xl leading-none tracking-wide whitespace-nowrap sm:text-[28px]">Tara \X/ Void</span>
    </a>
    <a
        href="https://github.com/taraxvoid"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="taraxvoid on GitHub"
        class="masthead-github font-redaction-20 text-[15px] tracking-wide"
    >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        <span>taraxvoid</span>
    </a>
    <div class="masthead-actions">
        <nav aria-label="Main">
            <a
                href={onResume ? '/' : '/resume'}
                aria-current={onResume ? 'page' : undefined}
                class="masthead-nav-link px-4 py-2 font-redaction-35 text-sm uppercase tracking-[0.08em]"
            >
                Resume
            </a>
        </nav>
        <ThemeToggle />
    </div>
</header>

<style>
    .masthead {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas:
            'lockup actions'
            'github github';
        align-items: center;
        gap: 0.75rem 1rem;
        border-inline: 2px solid var(--color-ink);
        padding: 0.875rem 0.875rem;
    }
    @media (min-width: 40rem) {
        .masthead {
            gap: 0.5rem 1.5rem;
            padding: 1rem 1.25rem;
        }
    }
    a.masthead-lockup {
        grid-area: lockup;
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 0.75rem;
        width: fit-content;
        color: var(--color-ink);
        text-decoration: none;
    }
    a.masthead-lockup:hover,
    a.masthead-lockup:focus-visible {
        color: var(--color-ink);
        opacity: 0.75;
    }
    a.masthead-github {
        grid-area: github;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        width: fit-content;
        color: var(--color-ink);
        text-underline-offset: 3px;
    }
    a.masthead-github:hover {
        color: var(--color-verified-hover);
    }
    .masthead-actions {
        grid-area: actions;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.625rem;
    }
    /* Resume is the primary action, so it is filled; on the resume page it
       drops to an outline to say "you are here". */
    a.masthead-nav-link {
        display: inline-block;
        border: 1px solid var(--color-verified);
        background: var(--color-verified);
        color: var(--color-on-verified);
        text-decoration: none;
        transition:
            background-color 0.15s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }
    a.masthead-nav-link:hover,
    a.masthead-nav-link:focus-visible {
        background: var(--color-verified-hover);
        border-color: var(--color-verified-hover);
        color: var(--color-on-verified);
    }
    a.masthead-nav-link[aria-current='page'] {
        background: transparent;
        border-color: var(--color-verified);
        color: var(--color-verified);
    }
    a.masthead-nav-link[aria-current='page']:hover,
    a.masthead-nav-link[aria-current='page']:focus-visible {
        background: var(--color-verified);
        color: var(--color-on-verified);
    }
</style>
