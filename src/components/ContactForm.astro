---
import SectionHeading from './SectionHeading.astro'

// Cloudflare's always-pass test key; the production key rejects localhost.
const siteKey = import.meta.env.DEV
    ? '1x00000000000000000000AA'
    : '0x4AAAAAAFJlbd0V5F4X3byG'
---

<form id="contact" method="POST" action="/api/contact" aria-label="Contact" class="flex flex-col gap-3.5">
    <SectionHeading>Contact Me</SectionHeading>

    <div class="contact-frame">
        <div class="contact-input">
            <textarea
                id="contact-message"
                name="message"
                required
                rows="1"
                maxlength="140"
                placeholder=" "
                aria-label="Message"
                aria-describedby="contact-prompt contact-count"
                class="contact-textarea font-redaction-35 text-[18px]"
            ></textarea>
            <span class="contact-cursor" aria-hidden="true"></span>
        </div>
        <div
            id="contact-count"
            class="border-t border-dotted px-3 py-1 text-right font-mono text-xs"
            style="border-color: var(--color-paper-line); color: var(--color-secondary);"
        >
            0/140
        </div>
    </div>
    <p id="contact-count-alert" role="status" class="sr-only"></p>

    <div id="contact-email" hidden class="flex flex-col gap-1.5">
        <label for="contact-email-input" class="font-mono text-xs" style="color: var(--color-secondary);">
            Reply-to email (optional)
        </label>
        <input
            id="contact-email-input"
            type="email"
            name="email"
            autocomplete="email"
            maxlength="254"
            class="contact-email font-redaction-35 text-[18px]"
        />
    </div>

    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <div id="contact-turnstile" data-sitekey={siteKey}></div>
    <button
        type="submit"
        class="contact-submit w-full px-3 py-2.5 font-redaction-35 text-[18px] disabled:opacity-50"
        style="background: var(--color-verified); color: var(--color-on-verified); text-decoration-line: none;"
    >
        Send Message
    </button>

    <p id="contact-status" role="status" hidden class="border px-4 py-3 text-sm"></p>
</form>

<style>
    /* Dotted rules either side of the heading, like a carrier signal. */
    .contact-rule {
        flex: 1;
        border-top: 2px dotted var(--color-paper-line);
    }
    .contact-frame,
    .contact-email {
        border: 2px solid var(--color-verified);
        background: var(--color-surface);
        color: var(--color-ink);
    }
    .contact-email {
        padding: 0.5rem 0.75rem;
    }
    .contact-submit:focus-visible {
        outline: 3px solid var(--color-focus);
        outline-offset: 2px;
    }
    /* Ink (not the global focus color) so the ring reads against the
       verified-colored border instead of clashing with it. */
    .contact-frame:focus-within,
    .contact-email:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 3px;
    }
    .contact-email:focus-visible {
        outline-offset: 2px;
    }
    .contact-input {
        position: relative;
    }
    .contact-textarea {
        display: block;
        width: 100%;
        resize: none;
        border: 0;
        background: transparent;
        color: var(--color-ink);
        caret-color: var(--color-ink);
        padding: 0.75rem 0.75rem 0.75rem 2rem;
        outline: none;
    }
    .contact-textarea::placeholder {
        color: var(--color-secondary);
        opacity: 1;
    }
    /* Decorative block cursor, shown only while the field is empty and idle.
       The real caret takes over on focus, so selection, IME and screen readers are untouched. */
    .contact-cursor {
        position: absolute;
        left: 0.75rem;
        top: 0.95rem;
        width: 0.7rem;
        height: 1.2rem;
        background: var(--color-ink);
        pointer-events: none;
        display: none;
    }
    .contact-textarea:placeholder-shown:not(:focus) + .contact-cursor {
        display: block;
    }
    @media (prefers-reduced-motion: no-preference) {
        .contact-cursor {
            animation: contact-blink 1.1s steps(1) infinite;
        }
    }
    /* After a successful send, only the confirmation stays. */
    form[data-sent] > :not(#contact-status) {
        display: none;
    }
    @keyframes contact-blink {
        50% {
            opacity: 0;
        }
    }
</style>

<script>
    type TurnstileApi = {
        render: (
            container: HTMLElement,
            options: { sitekey: string; action: string; appearance?: 'always' | 'execute' | 'interaction-only' }
        ) => string;
        reset: (widgetId: string) => void;
    };
    const turnstileWindow = window as Window & { turnstile?: TurnstileApi };

    const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';

    const loadTurnstile = () =>
        new Promise<TurnstileApi>((resolve, reject) => {
            if (turnstileWindow.turnstile) return resolve(turnstileWindow.turnstile);
            const script = document.createElement('script');
            script.src = TURNSTILE_SRC;
            script.async = true;
            script.addEventListener('load', () => {
                if (turnstileWindow.turnstile) resolve(turnstileWindow.turnstile);
                else reject(new Error('turnstile unavailable'));
            });
            script.addEventListener('error', () => reject(new Error('turnstile failed to load')));
            document.head.appendChild(script);
        });

    const initContactForm = () => {
        const form = document.getElementById('contact') as HTMLFormElement | null;
        const container = document.getElementById('contact-turnstile');
        const status = document.getElementById('contact-status');
        if (!form || !container || !status) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        const message = form.querySelector<HTMLTextAreaElement>('#contact-message');
        const count = document.getElementById('contact-count');
        const countAlert = document.getElementById('contact-count-alert');
        const emailRow = document.getElementById('contact-email');
        const idleLabel = button?.textContent?.trim() || 'Send Message';

        let widgetId: string | undefined;

        // Reveal the optional email field the first time the message field is used.
        message?.addEventListener('focus', () => {
            if (emailRow) emailRow.hidden = false;
        });

        const updateCount = () => {
            if (!message || !count) return;
            const left = message.maxLength - message.value.length;
            count.textContent = `${message.value.length}/${message.maxLength}`;
            // Only announce near the limit so screen readers aren't narrating every keystroke.
            if (countAlert) {
                countAlert.textContent = left <= 20 && left % 10 === 0 ? `${left} characters left` : '';
            }
        };
        message?.addEventListener('input', updateCount);
        form.addEventListener('reset', () => setTimeout(updateCount));

        const show = (kind: 'success' | 'error', text: string) => {
            status.textContent = text;
            status.style.borderColor = kind === 'success' ? 'var(--color-verified)' : 'var(--color-redpen)';
            status.style.color = kind === 'success' ? 'var(--color-verified)' : 'var(--color-redpen)';
            status.hidden = false;
        };

        loadTurnstile()
            .then((turnstile) => {
                widgetId = turnstile.render(container, {
                    sitekey: container.dataset.sitekey as string,
                    action: 'contact',
                    // Stay invisible unless Cloudflare needs the visitor to interact.
                    appearance: 'interaction-only'
                });
            })
            .catch(() => show('error', 'Could not load the verification widget. Reload the page and try again.'));

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (button) {
                button.disabled = true;
                button.textContent = 'Sending Your Message...';
            }
            status.hidden = true;
            try {
                const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                if (response.status === 429) {
			show('error', 'Only one message per hour, please try again later.');
                    return;
                }
                if (!response.ok) throw new Error(String(response.status));
                form.reset();
                form.dataset.sent = '';
                show('success', 'Message received.');
            } catch {
                show('error', 'Something went wrong. Please try again.');
            } finally {
                // Turnstile tokens are single-use; get a fresh one for any retry.
                if (widgetId !== undefined) turnstileWindow.turnstile?.reset(widgetId);
                if (button) {
                    button.disabled = false;
                    button.textContent = idleLabel;
                }
            }
        });
    };

    initContactForm();
</script>
