---
import DossierRow from './DossierRow.astro';

// Cloudflare's always-pass test key; the production key rejects localhost.
const siteKey = import.meta.env.DEV ? '1x00000000000000000000AA' : '0x4AAAAAAFJlbd0V5F4X3byG';
---

<form id="contact" method="POST" action="/api/contact" aria-label="Contact" class="flex flex-col gap-3.5">
    <DossierRow label="Open Channel" emphasis>
        <textarea
            name="message"
            aria-label="Open Channel"
            required
            rows="1"
            maxlength="140"
            class="w-full max-w-xs border px-3 py-2 text-[15px]"
            style="border-color: var(--color-ink); background: var(--color-surface); color: var(--color-ink);"
        ></textarea>
    </DossierRow>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <div class="flex flex-col items-end"> 
        <div id="contact-turnstile" data-sitekey={siteKey}></div>
        <button
            type="submit"
	    class="px-3 py-1.5 font-redaction-35 text-[18px] disabled:opacity-50"
            style="background: var(--color-verified); color: var(--color-on-verified); text-decoration-line: none;"
        >
            Send Transmission
        </button>
    </div>

    <p id="contact-status" role="status" hidden class="border px-4 py-3 text-sm"></p>
</form>

<script>
    type TurnstileApi = {
        render: (
            container: HTMLElement,
            options: { sitekey: string; action: string; appearance?: 'always' | 'execute' | 'interaction-only' }
        ) => string;
        reset: (widgetId: string) => void;
    };
    const turnstileWindow = window as Window & { turnstile?: TurnstileApi };

    const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';

    const loadTurnstile = () =>
        new Promise<TurnstileApi>((resolve, reject) => {
            if (turnstileWindow.turnstile) return resolve(turnstileWindow.turnstile);
            const script = document.createElement('script');
            script.src = TURNSTILE_SRC;
            script.async = true;
            script.addEventListener('load', () => {
                if (turnstileWindow.turnstile) resolve(turnstileWindow.turnstile);
                else reject(new Error('turnstile unavailable'));
            });
            script.addEventListener('error', () => reject(new Error('turnstile failed to load')));
            document.head.appendChild(script);
        });

    const initContactForm = () => {
        const form = document.getElementById('contact') as HTMLFormElement | null;
        const container = document.getElementById('contact-turnstile');
        const status = document.getElementById('contact-status');
        if (!form || !container || !status) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        let widgetId: string | undefined;
        let hideTimer: ReturnType<typeof setTimeout> | undefined;

        const show = (kind: 'success' | 'error', text: string) => {
            clearTimeout(hideTimer);
            status.textContent = text;
            status.style.borderColor = kind === 'success' ? 'var(--color-verified)' : 'var(--color-redpen)';
            status.style.color = kind === 'success' ? 'var(--color-verified)' : 'var(--color-redpen)';
            status.hidden = false;
            if (kind === 'success') {
                hideTimer = setTimeout(() => {
                    status.hidden = true;
                }, 5000);
            }
        };

        loadTurnstile()
            .then((turnstile) => {
                widgetId = turnstile.render(container, {
                    sitekey: container.dataset.sitekey as string,
                    action: 'contact',
                    // Stay invisible unless Cloudflare needs the visitor to interact.
                    appearance: 'interaction-only'
                });
            })
            .catch(() => show('error', 'Could not load the verification widget. Reload the page and try again.'));

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (button) button.disabled = true;
            status.hidden = true;
            try {
                const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                if (response.status === 429) {
                    show('error', 'Only one message per hour is allowed. Please try again later.');
                    return;
                }
                if (!response.ok) throw new Error(String(response.status));
                form.reset();
                show('success', 'Message received.');
            } catch {
                show('error', 'Something went wrong. Please try again.');
            } finally {
                // Turnstile tokens are single-use; get a fresh one for any retry.
                if (widgetId !== undefined) turnstileWindow.turnstile?.reset(widgetId);
                if (button) button.disabled = false;
            }
        });
    };

    document.addEventListener('astro:page-load', initContactForm);
</script>
