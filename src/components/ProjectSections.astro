---
import { projects } from '../data/projects';
import SectionHeading from './SectionHeading.astro';
import WorkEntry from './WorkEntry.astro';

const openSource = projects.filter((p) => p.group === 'open-source');
const professional = projects.filter((p) => p.group === 'professional');
---

<div class="flex flex-col">
    <SectionHeading href="https://github.com/taraxvoid" linkLabel="taraxvoid on GitHub">Open Source</SectionHeading>
    {openSource.map((project) => <WorkEntry project={project} />)}
    <SectionHeading>Professional Work</SectionHeading>
    {professional.map((project) => <WorkEntry project={project} />)}
    <div class="border-t" style="border-color: var(--color-ink);"></div>
</div>
