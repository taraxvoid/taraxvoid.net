{
    /* Hidden until the script runs: without JS a dead control would be worse
    than none, and the site already follows the browser preference.
    Which icon shows is pure CSS (resolved scheme), so there is no flash. */
}
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme" hidden>
    <svg class="icon icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="icon icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
</button>

<style is:global>
    .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: 1px solid var(--color-ink);
        background: transparent;
        color: var(--color-ink);
        cursor: pointer;
    }
    .theme-toggle[hidden] {
        display: none;
    }
    .theme-toggle:hover {
        background: var(--color-ink);
        color: var(--color-paper);
    }
    .theme-toggle:focus-visible {
        outline: 3px solid var(--color-focus);
        outline-offset: 2px;
    }
    /* Show the icon for the theme you would switch to: sun while dark, moon
       while light. No data-theme means "system", so follow the media query. */
    .theme-toggle .icon-sun {
        display: none;
    }
    @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .theme-toggle .icon-sun {
            display: block;
        }
        :root:not([data-theme='light']) .theme-toggle .icon-moon {
            display: none;
        }
    }
    :root[data-theme='dark'] .theme-toggle .icon-sun {
        display: block;
    }
    :root[data-theme='dark'] .theme-toggle .icon-moon {
        display: none;
    }
</style>

<script>
    import { applyPreference, readStoredPreference, resolveTheme, writeStoredPreference } from '../lib/theme';
    import { safeStorage, syncThemeColor } from '../lib/theme-client';

    const systemDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;

    function labelFor(button: HTMLButtonElement) {
        const resolved = resolveTheme(readStoredPreference(safeStorage()), systemDark());
        button.setAttribute('aria-label', resolved === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    }

    // The toggle is replaced on every ClientRouter navigation, so wire it up
    // on each page load rather than once.
    document.addEventListener('astro:page-load', () => {
        const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        if (!button) return;
        labelFor(button);
        button.hidden = false;
        button.addEventListener('click', () => {
            const current = resolveTheme(readStoredPreference(safeStorage()), systemDark());
            const next = current === 'dark' ? 'light' : 'dark';
            // Landing back on what the browser prefers returns to "system",
            // so the site keeps following the OS until you pick against it.
            const preference = next === resolveTheme('system', systemDark()) ? 'system' : next;
            applyPreference(document.documentElement, preference);
            writeStoredPreference(safeStorage(), preference);
            syncThemeColor(preference);
            labelFor(button);
        });
    });
</script>
