---
// Click/tap/Enter-to-reveal spoiler. Content stays in the DOM (this is a
// reveal gag, not a secret) but is blacked out and inert until activated,
// after which links inside it behave normally.
interface Props {
    label: string;
}

const { label } = Astro.props;
---

<span class="spoiler" role="button" tabindex="0" aria-label={label} data-spoiler>
    <span class="spoiler__content" inert><slot /></span>
</span>

<style>
    .spoiler {
        display: inline-block;
        cursor: pointer;
        background: var(--color-redact);
        box-shadow: 0 0 0 1px var(--color-redact-edge);
        outline-offset: 2px;
    }
    .spoiler__content {
        display: inline-block;
        opacity: 0;
    }
    .spoiler[data-revealed] {
        cursor: auto;
        background: transparent;
    }
    .spoiler[data-revealed] .spoiler__content {
        opacity: 1;
    }
    @media (prefers-reduced-motion: no-preference) {
        .spoiler__content {
            transition: opacity 0.15s;
        }
    }
</style>

<script>
    function reveal(el: HTMLElement) {
        if (el.hasAttribute('data-revealed')) return;
        el.setAttribute('data-revealed', '');
        el.removeAttribute('role');
        el.removeAttribute('tabindex');
        el.removeAttribute('aria-label');
        el.querySelector('.spoiler__content')?.removeAttribute('inert');
    }

    document.querySelectorAll<HTMLElement>('[data-spoiler]').forEach((el) => {
        el.addEventListener('click', () => reveal(el));
        el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                reveal(el);
            }
        });
    });
</script>
