---
import type { Project } from '../data/projects';

interface Props {
    project: Project;
}

const { project } = Astro.props;
const spineColor = project.visibility === 'public' ? 'var(--color-verified)' : 'var(--color-flagged)';
---

<div class="flex gap-4 border-t border-dashed py-[18px]" style="border-color: var(--color-paper-line);">
    <div class="w-1 flex-shrink-0" style={`background: ${spineColor};`}></div>
    <div class="max-w-[560px] flex-1">
        <div class="flex items-baseline gap-2.5">
            <span class="font-mono text-[11px]" style="color: var(--color-secondary);">{project.ref}</span>
            <span class="text-[17px] font-bold">{project.title}</span>
        </div>
        <p class="pt-1 text-[15px] leading-relaxed">{project.description}</p>
        {
            project.annotation && (
                <div
                    class="flex w-fit items-center gap-1.5 pt-2.5 font-mono text-xs -rotate-2"
                    style="color: var(--color-redpen);"
                >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{project.annotation}</span>
                </div>
            )
        }
    </div>
    {
        project.visibility === 'public' ? (
            <a href={project.href} target="_blank" rel="noopener noreferrer" class="flex-shrink-0 whitespace-nowrap pt-1 text-sm">
                {project.linkLabel}
            </a>
        ) : (
            <div class="flex-shrink-0 pt-1 font-mono text-xs" style="color: var(--color-flagged);">
                private
            </div>
        )
    }
</div>
