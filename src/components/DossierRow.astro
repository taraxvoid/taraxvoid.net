---
interface Props {
    label: string
    /** Larger, darker, Redaction-typeface label used for the dossier info block. */
    emphasis?: boolean
    /** Bold the emphasized label. */
    bold?: boolean
}

const { label, emphasis = false, bold = true } = Astro.props
---

<div class="flex items-baseline gap-2.5">
    <span
        class={
            emphasis
                ? `w-[100px] flex-shrink-0 font-redaction-35 text-sm uppercase tracking-wide${bold ? ' font-bold' : ''}`
                : 'w-[88px] flex-shrink-0 font-mono text-xs'
        }
        style={`color: ${emphasis ? 'var(--color-ink)' : 'var(--color-secondary)'};`}
    >
        {label}
    </span>
    {/* The leader keeps a minimum width so a wrapping value stays pinned right
       instead of collapsing the leader and hanging off the label column. */}
    <span class="mb-1 min-w-6 flex-1 border-b border-dotted" style="border-color: var(--color-paper-line);"></span>
    <div class="min-w-0 text-right text-balance"><slot /></div>
</div>
