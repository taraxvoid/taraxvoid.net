---
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import WorkEntry from '../components/WorkEntry.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Activities - Tara \X/ Void" description="Case studies from RavenFlight Industries and community engineering work.">
    <div class="min-h-screen bg-desk p-8 sm:p-14">
        <div
            transition:name="sheet" class="sheet mx-auto max-w-[1296px] px-6 py-11 sm:px-[72px]"
        >
            <Masthead active="activities" />

            <main transition:name="content" class="flex flex-col py-9">
                <h1 class="sr-only">Known Activities</h1>
                <h2 class="border-t pt-5 pb-1 text-[15px] font-bold" style="border-color: var(--color-ink);">
                    Intel Collections
                </h2>
                {projects.map((project) => <WorkEntry project={project} />)}
                <div class="border-t" style="border-color: var(--color-ink);"></div>
            </main>

            <Footer />
        </div>
    </div>
</Layout>
