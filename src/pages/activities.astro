---
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import ProjectSections from '../components/ProjectSections.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Activities - Tara \X/ Void" description="Open-source and professional engineering work: CI/CD, coding-agent guardrails and community sites.">
    <div class="min-h-screen bg-desk p-8 sm:p-14">
        <div
            transition:name="sheet" class="sheet mx-auto max-w-[900px] px-6 py-5 sm:px-14"
        >
            <Masthead active="activities" />

            <main transition:name="content" class="flex flex-col py-9">
                <h1 class="sr-only">Known Activities</h1>
                <ProjectSections />
            </main>

            <Footer />
        </div>
    </div>
</Layout>
