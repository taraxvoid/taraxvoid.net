---
import ContactForm from '../components/ContactForm.astro';
import DossierRow from '../components/DossierRow.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import RedactedBar from '../components/RedactedBar.astro';
import Spoiler from '../components/Spoiler.astro';
import WorkEntry from '../components/WorkEntry.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Tara \X/ Void"
    description="Platform, DevEx, and security engineer. Founder / Principal Engineer at RavenFlight Industries."
>
    <div class="min-h-screen bg-desk p-8 sm:p-14">
        <div
            transition:name="sheet" class="sheet mx-auto max-w-[900px] px-6 py-11 sm:px-14"
        >
            <Masthead />

            <main transition:name="content">
                <h1 class="sr-only">Tara \X/ Void</h1>
                <div class="mt-2 border-t border-dashed" style="border-color: var(--color-paper-line);"></div>
                <div class="mx-auto flex max-w-[620px] flex-col gap-3.5 pb-9 pt-5 sm:pb-10 sm:pt-6">
                    <DossierRow label="AKA" emphasis>
                        <RedactedBar wordLengths={[3, 8]} label="redacted" />
                    </DossierRow>

                    <DossierRow label="Pronouns" emphasis>
                        <a
                            href="https://my.pronouns.page/are/xe&she"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-redaction-35 text-[15px] tracking-wide underline decoration-solid text-[var(--color-verified)] hover:text-[var(--color-verified-hover)]"
                        >
                            xe/xem she/her
                        </a>
                    </DossierRow>

                    <DossierRow label="Role" emphasis>
                        <span class="font-redaction-35 text-[15px] italic tracking-wide">Founder / Principal Engineer</span>
                    </DossierRow>

                    <DossierRow label="Employer" emphasis>
                        <Spoiler label="Employer (spoiler, activate to reveal)">
                            <a
                                href="https://ravenflight.io"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-baseline gap-px font-redaction-20 text-[20px] tracking-wide underline"
                                style="color: var(--color-ink);"
                            >
                                <span aria-hidden="true">[</span>RavenFlight<span aria-hidden="true">]</span>
                            </a>
                        </Spoiler>
                    </DossierRow>

                    <hr class="border-0 border-t border-dashed" style="border-color: var(--color-paper-line);" />
                    <ContactForm />
                </div>

                <div class="flex flex-col">
                    <h2 class="border-t pt-5 pb-1 text-[15px] font-bold" style="border-color: var(--color-ink);">
                        Activities
                    </h2>
                    {projects.map((project) => <WorkEntry project={project} />)}
                    <div class="border-t" style="border-color: var(--color-ink);"></div>
                </div>

                <div
                    class="mt-6 border border-dashed px-4 py-3 font-mono text-[13px]"
                    style="border-color: var(--color-paper-line);"
                >
                    GitHub: 1,842 contributions, 9 public repos, 41-day streak
                </div>
            </main>

            <Footer />
        </div>
    </div>
</Layout>
