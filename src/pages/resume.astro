---
import DossierRow from '../components/DossierRow.astro'
import Footer from '../components/Footer.astro'
import Masthead from '../components/Masthead.astro'
import {
    coreSkills,
    education,
    experience,
    location,
    openSource,
    summary,
} from '../data/resume'
import Layout from '../layouts/Layout.astro'

// Suggested save-as name, stamped at build time so a downloaded copy is
// identifiable on disk (the site is static, so this is the generation date).
const stamp = new Date().toISOString().slice(0, 10)
const downloadName = (ext: string) => `resume_Tara-X-Void-${stamp}.${ext}`
---

<Layout title="Resume - Tara \X/ Void" description={summary}>
    <div class="min-h-screen bg-desk p-8 sm:p-14">
        <div
            transition:name="sheet" class="sheet mx-auto max-w-[900px] px-6 py-5 sm:px-14"
        >
            <Masthead active="resume" />

            <main transition:name="content" class="py-9">
            <h1 class="sr-only">Resume</h1>
            <h2 class="border-t pb-1 pt-5 text-[15px] font-bold" style="border-color: var(--color-ink);">Resume</h2>
            <div class="flex flex-col gap-3 border-t border-dashed pb-7 pt-[18px]" style="border-color: var(--color-paper-line);">
                <DossierRow label="Based">
                    <span class="text-[15px]">{location}</span>
                </DossierRow>
                <div class="flex gap-4 pt-2 text-sm">
                    <a href="/resume.pdf" download={downloadName('pdf')}>Download resume as PDF file (.pdf)</a>
                    <a href="/resume.md" download={downloadName('md')}>Download resume as Markdown file (.md)</a>
                </div>
            </div>

            <p class="max-w-[70ch] pb-8 text-[15px] leading-relaxed">{summary}</p>

            <div class="border-t pt-5" style="border-color: var(--color-ink);">
                <h2 class="pb-3 text-[15px] font-bold">Core skills</h2>
                <ul class="flex flex-col gap-1.5 pb-8 text-[15px] leading-relaxed">
                    {coreSkills.map((skill) => <li>{skill}</li>)}
                </ul>
            </div>

            <div class="flex flex-col">
                <h2 class="border-t pb-1 pt-5 text-[15px] font-bold" style="border-color: var(--color-ink);">
                    Experience
                </h2>
                {
                    experience.map((entry) => (
                        <div class="border-t border-dashed py-[18px]" style="border-color: var(--color-paper-line);">
                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                                <span class="text-[17px] font-bold">{entry.org}</span>
                                <span class="font-mono text-xs" style="color: var(--color-secondary);">
                                    {entry.dates}
                                </span>
                            </div>
                            <div class="pt-1 text-[15px] italic">
                                {entry.role}, {entry.location}
                            </div>
                            <ul class="flex flex-col gap-1.5 pt-2 text-[15px] leading-relaxed">
                                {entry.highlights.map((h) => (
                                    <li>{h}</li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
                <div class="border-t" style="border-color: var(--color-ink);"></div>
            </div>

            <div class="border-t pt-5" style="border-color: var(--color-ink);">
                <h2 class="pb-3 text-[15px] font-bold">Open source</h2>
                <ul class="flex flex-col gap-1.5 pb-8 text-[15px] leading-relaxed">
                    {openSource.map((item) => <li>{item}</li>)}
                </ul>
            </div>

            <div class="border-t pt-5" style="border-color: var(--color-ink);">
                <h2 class="pb-2 text-[15px] font-bold">Education</h2>
                <p class="pb-8 text-[15px]">{education.school} - {education.degree}</p>
            </div>
            </main>

            <Footer />
        </div>
    </div>
</Layout>
