---
import DossierRow from '../components/DossierRow.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import { coreSkills, education, experience, location, summary } from '../data/resume';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume - Tara \X/ Void" description={summary}>
    <div class="min-h-screen bg-desk p-8 sm:p-14">
        <div
            class="sheet mx-auto max-w-[900px] px-6 py-11 sm:px-14"
        >
            <Masthead active="resume" />

            <main>
            <h1 class="sr-only">Resume</h1>
            <div class="flex flex-col gap-3 py-7">
                <DossierRow label="Based">
                    <span class="text-[15px]">{location}</span>
                </DossierRow>
                <!-- TODO: generate resume.pdf from this same data and link it here -->
                <div class="flex gap-4 pt-2 text-sm">
                    <a href="/resume.md" download>Download .md</a>
                </div>
            </div>

            <p class="max-w-[70ch] pb-8 text-[15px] leading-relaxed">{summary}</p>

            <div class="border-t pt-5" style="border-color: var(--color-ink);">
                <h2 class="pb-3 text-[15px] font-bold">Core skills</h2>
                <ul class="flex flex-col gap-1.5 pb-8 text-[15px] leading-relaxed">
                    {coreSkills.map((skill) => <li>{skill}</li>)}
                </ul>
            </div>

            <div class="flex flex-col">
                <h2 class="border-t pb-1 pt-5 text-[15px] font-bold" style="border-color: var(--color-ink);">
                    Experience
                </h2>
                {
                    experience.map((entry) => (
                        <div class="border-t border-dashed py-[18px]" style="border-color: var(--color-paper-line);">
                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                                <span class="text-[17px] font-bold">{entry.org}</span>
                                <span class="font-mono text-xs" style="color: var(--color-secondary);">
                                    {entry.dates}
                                </span>
                            </div>
                            <div class="pt-1 text-[15px] italic">
                                {entry.role}, {entry.location}
                            </div>
                            <ul class="flex flex-col gap-1.5 pt-2 text-[15px] leading-relaxed">
                                {entry.highlights.map((h) => (
                                    <li>{h}</li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
                <div class="border-t" style="border-color: var(--color-ink);"></div>
            </div>

            <div class="border-t pt-5" style="border-color: var(--color-ink);">
                <h2 class="pb-2 text-[15px] font-bold">Education</h2>
                <p class="pb-8 text-[15px]">{education.school} - {education.degree}</p>
            </div>
            </main>

            <Footer />
        </div>
    </div>
</Layout>
