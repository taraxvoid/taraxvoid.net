{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "taraxvoid-net",
    "compatibility_date": "2026-09-01",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "routes": [
        {
            "pattern": "taraxvoid.net",
            "custom_domain": true
        },
        {
            "pattern": "taraxvoid.com",
            "custom_domain": true
        }
    ]
}
