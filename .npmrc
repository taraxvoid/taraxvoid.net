# npm/npx cooldown allowlist. bunfig.toml's minimumReleaseAgeExcludes only
# covers bun; npm (and so npx) reads its own settings, so mirror the voidflow
# exemption here. Needs npm >= 11.17 (min-release-age-exclude); older npm
# ignores the key. Names only: version-scoped entries silently match nothing.
min-release-age-exclude[]=@taraxvoid/voidflow
min-release-age-exclude[]=voidflow
