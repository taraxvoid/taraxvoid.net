{
    "name": "taraxvoid.net",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "types": "wrangler types",
        "predev": "bun run types",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "wrangler dev --config dist/client/wrangler.json",
        "deploy": "wrangler deploy --config dist/client/wrangler.json",
        "check": "wrangler types && astro check",
        "check:licenses": "license-checker --production --failOn 'GPL-1.0;GPL-1.0-only;GPL-1.0-or-later;GPL-2.0;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0;GPL-3.0-only;GPL-3.0-or-later;AGPL-1.0;AGPL-1.0-only;AGPL-1.0-or-later;AGPL-3.0;AGPL-3.0-only;AGPL-3.0-or-later;SSPL-1.0;OSL-2.1;OSL-3.0;CPAL-1.0;EUPL-1.1;EUPL-1.2;CECILL-2.1'",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test:unit": "vitest run",
        "test:e2e:full": "playwright test --project=mobile-chrome",
        "test:e2e:a11y": "playwright test --project=a11y"
    },
    "dependencies": {
        "@astrojs/cloudflare": "14.1.5",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "7.2.8",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.10.1",
        "@biomejs/biome": "^1.9.4",
        "@playwright/test": "^1.49.1",
        "@tailwindcss/vite": "^4.3.3",
        "license-checker": "^25.0.1",
        "serve": "^14.2.6",
        "typescript": "^5.7.3",
        "vitest": "^3.0.5",
        "wrangler": "^4.131.2"
    }
}
