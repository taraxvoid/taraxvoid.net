{
    "name": "taraxvoid.net",
    "type": "module",
    "version": "0.1.0",
    "description": "taraxvoid.net portfolio/resume site",
    "private": true,
    "scripts": {
        "types": "wrangler types",
        "predev": "bun run types",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "deploy": "wrangler deploy",
        "check": "wrangler types && astro check",
        "check:licenses": "check-licenses",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "bun run build && npm-run-all -l -p check test:unit -s test:e2e:full",
        "test:unit": "vitest run",
        "test:e2e:full": "playwright test --project=mobile-chrome --project=desktop-chrome",
        "test:e2e:all": "bun run test:e2e:full",
        "test:e2e:a11y": "playwright test --project=a11y",
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "test:push": "bun run lint && bun run test",
        "lint:actions": "jactionlint --color",
        "audit": "bun audit --audit-level high --production"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "dependencies": {
        "@astrojs/cloudflare": "14.3.3",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "7.3.5",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.13.0",
        "@biomejs/biome": "^2.5.15",
        "@playwright/test": "^1.64.0",
        "@socketsecurity/bun-security-scanner": "^1.1.3",
        "@tailwindcss/vite": "^4.3.3",
        "@taraxvoid/voidflow": "^0.11.1",
        "@types/bun": "^1.4.2",
        "license-checker": "^25.0.1",
        "npm-run-all2": "^9.0.3",
        "serve": "^14.2.6",
        "typescript": "^5.9.3",
        "vitest": "^5.0.3",
        "wrangler": "^4.147.0"
    },
    "overrides": {
        "sharp": "^0.35.5"
    }
}
